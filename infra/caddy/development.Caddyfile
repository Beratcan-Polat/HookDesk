:80 {
	@receiver path /receive/*
	respond @receiver 404
	@backend path /api/* /sanctum/* /login /logout /register /email/* /user/* /two-factor-challenge /ingest/* /pending-email/* /up
	handle @backend {
		root * /srv/backend/public
		php_fastcgi app:9000
	}
	@password {
		path /forgot-password /reset-password
		method POST
	}
	handle @password {
		root * /srv/backend/public
		php_fastcgi app:9000
	}
	handle {
		reverse_proxy frontend-dev:5173
	}
}
